# Copy this file to .env and fill in your own keys. The .env file is git-ignored and must never be committed.

# Embeddings and reranking (https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-v5.0-pro
COHERE_EMBED_DIMENSION=1024
COHERE_RERANK_MODEL=rerank-v4.0-fast
COHERE_RERANK_REQUESTS_PER_MINUTE=10

# Vector database (https://console.weaviate.cloud)
WEAVIATE_URL=
WEAVIATE_API_KEY=
WEAVIATE_COLLECTION=WebsiteChunk
# One tenant for each environment: development, eval or demo (4 to 64 letters, digits, underscores or hyphens).
WEAVIATE_TENANT=development
WEAVIATE_INIT_TIMEOUT_SECONDS=30

# LLM (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional: more keys, separated by commas.
GROQ_BACKUP_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_GRADE_MODEL=openai/gpt-oss-20b
GROQ_TOKENS_PER_MINUTE=8000

# Downloading pages: the time limit of one step in seconds, and the largest page and PDF file in bytes (0 turns PDF off).
FETCH_TIMEOUT_SECONDS=20.0
FETCH_MAX_BYTES=5000000
PDF_MAX_BYTES=10000000
# Reading a PDF file: the most pages read, and the time limit of the reading in seconds.
PDF_MAX_PAGES=100
PDF_MAX_SECONDS=30.0

# A stored copy of a page or PDF file older than this many hours is loaded again. 0 (the default) never does that.
SOURCE_MAX_AGE_HOURS=0
# Before a stored copy is used, the website is asked whether the page changed, and the copy is made again if it did.
# A page checked less than this many seconds ago is not asked about again; 0 (the default) asks at every question.
SOURCE_CHECK_SECONDS=0

# Limits for one question. When a limit is reached the agent answers with what it has, or says that the source does
# not cover the question. Following links needs room: 3 hops and 2 rewrites can take 24 steps and 12 model calls.
AGENT_MAX_STEPS=24
# How many times the agent may choose links of a site to open, and the most pages it may load that way. 0 in either
# keeps the agent on the pages it was given.
AGENT_MAX_LINK_HOPS=3
AGENT_MAX_PAGES=5
AGENT_MAX_LLM_CALLS=12
AGENT_MAX_REWRITES=2

# Limits for one evaluation run, so that a run can never use up a quota. The run stops at the first limit.
EVAL_MAX_COHERE_CALLS=300
EVAL_MAX_GROQ_CALLS=200
EVAL_MAX_GROQ_TOKENS=120000
# The model that judges the answers of an evaluation run.
EVAL_JUDGE_MODEL=openai/gpt-oss-20b
# The baseline "crawl" loads the pages of a site before it answers: at most this many pages, at most this many links
# away from the given page. Every page costs Cohere calls, so keep the number low.
EVAL_CRAWL_MAX_PAGES=40
EVAL_CRAWL_MAX_DEPTH=2
