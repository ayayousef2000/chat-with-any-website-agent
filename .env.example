# Copy this file to .env and fill in your keys. Use keys of their own for this project: never reuse the keys of
# another project. The settings below are planned; the code does not read them yet.

# Embeddings and reranking (https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-v5.0-pro
COHERE_EMBED_DIMENSION=1024
COHERE_RERANK_MODEL=rerank-v4.0-fast

# Vector database (https://console.weaviate.cloud), a cluster of its own under a separate account.
WEAVIATE_URL=
WEAVIATE_API_KEY=
WEAVIATE_COLLECTION=WebsiteChunk
# One multi-tenant collection with one tenant for each environment (development, eval and demo), because a free
# Weaviate Cloud plan allows one collection and three tenants. A name has 4 to 64 letters, digits, underscores or hyphens.
WEAVIATE_TENANT=development
WEAVIATE_INIT_TIMEOUT_SECONDS=30

# LLM (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TOKENS_PER_MINUTE=8000

# Limits for one question. When a limit is reached the agent answers with what it has, or says that the source does
# not cover the question.
AGENT_MAX_STEPS=8
AGENT_MAX_LINK_HOPS=3
AGENT_MAX_LLM_CALLS=8
AGENT_MAX_REWRITES=2

# Limits for one evaluation run, so that a run can never use up a quota. The run stops at the first limit.
EVAL_MAX_COHERE_CALLS=300
EVAL_MAX_GROQ_CALLS=200
EVAL_MAX_GROQ_TOKENS=120000
